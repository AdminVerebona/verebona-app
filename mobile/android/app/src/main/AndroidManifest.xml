<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lot 95 : aucune sauvegarde ni transfert des données de l'app (session,
         préférences) — AUTH-13 « réinstallation = nouvel appareil ». -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- VEREBONA:APP_LINKS:BEGIN — généré par `npm run sync:links` depuis src/lib/mobile/app-links.ts (ne pas modifier à la main) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appHost}" />
                <data android:pathPrefix="/verify-email" />
                <data android:pathPrefix="/reset-password" />
                <data android:pathPrefix="/duo/join/" />
                <data android:pathPrefix="/assets/" />
                <data android:pathPrefix="/documents/" />
                <data android:path="/documents" />
                <data android:pathPrefix="/agenda" />
                <data android:pathPrefix="/accueil/a-traiter" />
                <data android:path="/accueil" />
                <data android:pathPrefix="/transmission/" />
                <data android:path="/mon-compte/notifications" />
                <data android:pathPrefix="/mon-compte/confirmer-adresse" />
                <data android:path="/mon-compte" />
                <data android:path="/app/retour-connexion" />
            </intent-filter>
            <!-- VEREBONA:APP_LINKS:END -->

            <!-- Retour Google / Apple par schéma privé (RFC 8252), si APP_OAUTH_RETURN_URL l'utilise.
                 Seul `<schéma>:/oauth?handoff=…` est accepté par l'app (lib/native/deep-links.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${urlScheme}" />
            </intent-filter>

            <!-- Partage entrant (IMP-02) : un ou plusieurs PDF / images. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Push : pas d'initialisation automatique de FCM ni d'Analytics ; le
             jeton n'est demandé qu'après l'accord de l'utilisateur (PUSH-02). -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
    </application>

    <!-- Permissions (STORE-04 : uniquement celles utilisées). Les plugins ajoutent les leurs
         à la fusion du manifeste : notifications (POST_NOTIFICATIONS), envoi de fond
         (FOREGROUND_SERVICE_DATA_SYNC). Le scanner ML Kit n'exige pas CAMERA. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
