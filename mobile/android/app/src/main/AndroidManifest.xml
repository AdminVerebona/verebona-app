<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lot 95 : aucune sauvegarde ni transfert des données de l'app (session,
         préférences) — AUTH-13 « réinstallation = nouvel appareil ». -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- VEREBONA:APP_LINKS:BEGIN — généré par `npm run sync:links` depuis src/lib/mobile/app-links.ts (ne pas modifier à la main) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appHost}" />
                <data android:pathPrefix="/verify-email" />
                <data android:pathPrefix="/reset-password" />
                <data android:pathPrefix="/duo/join/" />
                <data android:pathPrefix="/assets/" />
                <data android:pathPrefix="/documents/" />
                <data android:path="/documents" />
                <data android:pathPrefix="/agenda" />
                <data android:pathPrefix="/accueil/a-traiter" />
                <data android:path="/accueil" />
                <data android:pathPrefix="/transmission/" />
                <data android:path="/mon-compte/notifications" />
                <data android:pathPrefix="/mon-compte/confirmer-adresse" />
                <data android:path="/mon-compte" />
                <data android:path="/app/retour-connexion" />
            </intent-filter>
            <!-- VEREBONA:APP_LINKS:END -->

            <!-- Retour Google / Apple par schéma privé (RFC 8252), si APP_OAUTH_RETURN_URL l'utilise.
                 Seul `<schéma>:/oauth?handoff=…` est accepté par l'app (lib/native/deep-links.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${urlScheme}" />
            </intent-filter>

            <!-- Lot 110A : le partage entrant (ACTION_SEND / SEND_MULTIPLE) est reçu par
                 ShareReceiverActivity (écran de décision léger à trois choix), plus par
                 cette activité : aucun formulaire « Ajouter un document » après un partage. -->
        </activity>

        <!-- Lot 110A : réception d'un partage natif (décision PO du 04/11/2026).
             Formats = formats documentaires acceptés par le serveur (src/lib/mobile/share-import-policy.ts) ;
             photos HEIC / HEIF (image/*) converties en JPEG. Le texte seul (liens, sélections)
             ne fait pas apparaître Verebona. Partage MULTIPLE de types mêlés (ex. PDF + photo :
             type commun « */* ») accepté, chaque fichier d'un format refusé étant signalé.
             Activité à part (tâche propre, exclue des récents) : « Importer sans ouvrir »
             la termine et rend la main à l'application source. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="fr.verebona.app.share"
            android:launchMode="standard"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Push : pas d'initialisation automatique de FCM ni d'Analytics ; le
             jeton n'est demandé qu'après l'accord de l'utilisateur (PUSH-02). -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <!-- Lot 102C (décision PO : Firebase Analytics désactivé tant qu'aucun besoin n'est validé) :
             désactivation DÉFINITIVE de la collecte (non réactivable à l'exécution), sans identifiant
             publicitaire ni signaux de personnalisation, au cas où une dépendance tirerait le SDK. -->
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
    </application>

    <!-- Permissions (STORE-04 : uniquement celles utilisées). Les plugins ajoutent les leurs
         à la fusion du manifeste : notifications (POST_NOTIFICATIONS), envoi de fond
         (FOREGROUND_SERVICE_DATA_SYNC). Le scanner ML Kit n'exige pas CAMERA. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
