NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000
# URL publique de l'app (sans slash final). Sert aussi aux retours Stripe
# (paiement reussi, « Retour au site », portail client) : en preprod/prod,
# mettre l'URL vue par le navigateur, jamais l'adresse interne du conteneur.
# Ex. preprod : https://app.preprod.verebona.fr
NEXT_PUBLIC_APP_URL=http://localhost:3001
# URL publique lue à l'exécution (prioritaire). À renseigner sur chaque
# environnement hébergé : elle sert aux retours Stripe (paiement, « Retour au site »).
# Une valeur localhost est ignorée quand la requête arrive par un domaine public.
APP_URL=

# --- Secrets de signature (OBLIGATOIRES en production) ---
# Session (jetons JWT). Valeur aléatoire longue, ex. `openssl rand -base64 48`.
JWT_SECRET=
# Liens envoyés par e-mail : vérification d'adresse et réinitialisation du mot
# de passe (jetons HMAC signés, à durée limitée, à usage unique). Facultatifs :
# à défaut, JWT_SECRET est utilisé. Les définir sépare les secrets.
# ⚠️ En production (NODE_ENV=production), le serveur REFUSE DE DÉMARRER si ni
# le secret dédié ni JWT_SECRET n'est défini (src/instrumentation.ts) : la
# valeur de repli est publique, les liens seraient fabricables.
# Changer ce secret invalide les liens en cours (l'utilisateur en redemande un).
EMAIL_VERIFICATION_SECRET=
PASSWORD_RESET_SECRET=

# --- Tâches planifiées (routes /api/cron/*) ---
# Secret exigé par TOUTES les routes /api/cron/* : en-tête
#   Authorization: Bearer <CRON_SECRET>
# Obligatoire dès qu'un planificateur externe (ou un appel manuel) les
# déclenche. Valeur aléatoire longue ; ne jamais la mettre dans une URL.
CRON_SECRET=
#
# Planification INTERNE (aucune configuration d'hébergeur requise) : démarrée
# par src/instrumentation.ts, une exécution par jour quel que soit le nombre
# d'instances (bail en base, table job_locks). Heures de Paris :
#   01h-05h  sauvegarde de la base            (≡ GET /api/cron/backup)
#   05h-08h  purge des exports RGPD expirés   (≡ GET /api/cron/gdpr-exports-purge)
#   06h-10h  ancienneté des sauvegardes > 48 h → anomalie de Supervision
#   08h-12h  cycle d'impayé de 90 jours       (≡ GET /api/cron/billing-unpaid)
# Les autres routes /api/cron/* (expire-trials, notifications/dispatch,
# referral-rewards, account-deletion/process, withdrawal/process,
# duo-dunning, purge-blobs…) ne sont planifiées NULLE PART dans le dépôt
# (ni vercel.json, ni render.yaml, ni workflow) : elles dépendent du
# planificateur externe de l'hébergement, à configurer avec CRON_SECRET.
#
# Désactive toutes les tâches quotidiennes internes ci-dessus (hors sauvegarde,
# qui a BACKUP_DISABLED) — ex. si un planificateur externe les appelle déjà.
DAILY_JOBS_DISABLED=false
# Cycle d'impayé : live (rappels J-7/J-1 et suppression à J+90 après
# revérification Stripe) | dry (simulation journalisée, rien n'est écrit —
# recommandé au premier passage en production) | off.
# Valeur inconnue => dry (jamais de suppression sur une faute de frappe).
BILLING_UNPAID_SWEEP=live
# Durée de conservation des archives « Mes données » (heures), purgées ensuite.
GDPR_EXPORT_RETENTION_HOURS=72

# --- Inscription : pré-lancement (src/lib/prelaunch.ts) ---
# full      : inscription ouverte (comportement historique).
# prelaunch : /signup affiche « Verebona ouvre bientôt » et POST /api/users
#             répond 403 SIGNUP_CLOSED, SAUF invitation valide (compte partagé
#             ou Premium Duo). Les comptes créés par admin/seed ne sont pas concernés.
# Absente ou vide => full (aucun environnement fermé par surprise).
# Valeur inconnue => prelaunch (fermé par prudence). « open » = synonyme de full.
# Mêmes valeurs que VITE_DEFAULT_SITE_MODE du site public : basculer les deux
# ensemble au lancement commercial. Lue à l'exécution : redémarrer suffit.
# Production pendant le pré-lancement : SIGNUP_MODE=prelaunch
SIGNUP_MODE=full

# --- Stripe : cles ---
# Toutes les valeurs Stripe d'un environnement doivent venir du MEME mode :
#   local / preprod / recette -> mode Test (sk_test_...)
#   production                -> mode Live (sk_live_...)
# Le client Stripe refuse de demarrer si le mode de la cle ne correspond pas
# a NEXT_PUBLIC_APP_ENV (production|prod|live => live, sinon test).
# Controle complet : npm run stripe:check
STRIPE_SECRET_KEY=
# Secret de l'endpoint webhook cree dans le dashboard, dans le meme mode, sur
#   <NEXT_PUBLIC_APP_URL>/api/billing/stripe-webhook
# Evenements : checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Optionnel : force le mode attendu (test|live) si NEXT_PUBLIC_APP_ENV ne suffit pas
# STRIPE_EXPECTED_MODE=test

# --- Stripe : prix de la tarification V2 (CDC) ---
# Genere par : npx tsx src/db/seeds/seed-stripe-prices.ts (avec la cle du bon mode)
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_DUO_MONTHLY=
STRIPE_PRICE_PREMIUM_DUO_YEARLY=

# ── Web Push / VAPID (CDC Notifications §14.5) ──────────────────────────────
# Générer une paire de clés avec : npx web-push generate-vapid-keys
# La clé privée ne doit JAMAIS être exposée au client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@verebona.fr

# Activation générale
VEREBONA_ASSISTANT_ENABLED=true
VEREBONA_ASSISTANT_AI_ENABLED=true
VEREBONA_ASSISTANT_AI_FALLBACK_ENABLED=true

# Alias de modèles (le métier n'utilise JAMAIS un id modèle en dur — §15.11)
VEREBONA_ASSISTANT_DEFAULT_MODEL_ALIAS=assistant-default
VEREBONA_ASSISTANT_ESCALATION_MODEL_ALIAS=assistant-escalation
# Résolution des alias → ids fournisseur (jamais "latest" — §15.13)
VEREBONA_ASSISTANT_MODEL_ASSISTANT_DEFAULT=gemini-2.5-flash-lite
VEREBONA_ASSISTANT_MODEL_ASSISTANT_ESCALATION=gemini-3.1-flash-lite

# Budget IA (§15.5 / §31.2)
VEREBONA_ASSISTANT_MAX_AI_CALLS_PER_REQUEST=2
VEREBONA_ASSISTANT_MAX_INPUT_TOKENS=12000
VEREBONA_ASSISTANT_MAX_OUTPUT_TOKENS=500
VEREBONA_ASSISTANT_MAX_SOURCES=8
VEREBONA_ASSISTANT_MAX_VISIBLE_SOURCES=5
VEREBONA_ASSISTANT_MAX_EXCERPT_CHARS=1500
VEREBONA_ASSISTANT_MAX_CANDIDATES=20

# Timeouts (§30.2)
VEREBONA_ASSISTANT_AI_TIMEOUT_MS=12000
VEREBONA_ASSISTANT_TOTAL_TIMEOUT_MS=20000

# Historique / rate limit / locale (§24 / §6.6 / §21)
VEREBONA_ASSISTANT_HISTORY_DAYS=7
VEREBONA_ASSISTANT_RATE_LIMIT_PER_MINUTE=10
VEREBONA_ASSISTANT_LOCALE=fr-FR

# Cache (§31)
VEREBONA_ASSISTANT_RETRIEVAL_CACHE_TTL_SECONDS=300
VEREBONA_ASSISTANT_HELP_CACHE_TTL_SECONDS=86400
VEREBONA_ASSISTANT_IDEMPOTENCY_TTL_SECONDS=900

# Garde-fous (interdits en V1 — §15.7 / §25.4)
VEREBONA_ASSISTANT_WEB_GROUNDING_ENABLED=false
VEREBONA_ASSISTANT_GEMINI_STORE=false

# Alertes coût (§31.3)
VEREBONA_ASSISTANT_COST_ALERT_USD=0.005

# Clé API Gemini (niveau PAYANT en prod — le gratuit est interdit, §29.5)
# Réutilise la clé existante du projet si déjà présente (doc-ai).
# GEMINI_API_KEY=...

# ══════════════════════════════════════════════════════════════════════════
# REFONTE IA 11 → 5 USAGES — bascule et socle (CDC §10.1)
# ══════════════════════════════════════════════════════════════════════════
# Valeurs admises pour chaque flag :
#   legacy   → ancien moteur seul (valeur par défaut)
#   shadow   → le nouveau moteur décide SANS écrire, les écarts sont mesurés
#   enabled  → nouveau moteur seul, l'ancien est hors du chemin d'exécution
#
# ⚠️ CDC §10.4 — un flag active le nouveau moteur À LA PLACE de l'ancien.
#    Aucune double écriture n'est autorisée, hors mode shadow.

AI_UNIFIED_SOURCE_ANALYSIS=legacy
AI_RECONCILIATION_ENGINE=legacy
AI_INTELLIGENT_ASSISTANT=legacy
AI_AGENDA_ENGINE=legacy
AI_PROMPT_GOVERNANCE=legacy

# Clé fournisseur — utilisée UNIQUEMENT par
# src/services/ai/gateway/providers/gemini.provider.ts (CDC §12, critère 4).
# GEMINI_API_KEY=...

# ─── Corpus de recette IA (CDC §11.1) ────────────────────────────────────────
# Compte technique portant les appels modeles de la campagne de mesure.
# Rattacher la campagne a un compte client melangerait ses couts reels avec
# ceux de la mesure, et fausserait le chiffrage que le corpus sert a produire.
#
# Obtenir l'identifiant :  npm run db:seed:corpus-account
# Non requis pour `npm run corpus:dry`, qui n'emet aucun appel.
CORPUS_ACCOUNT_ID=

# ── Sauvegarde quotidienne de la base (stockage OVH_S3_BUCKET, préfixe backups/) ──
# Nuit, entre 1 h et 5 h (Paris). Déclenchement manuel : /admin/backups ou GET /api/cron/backup.
BACKUP_RETENTION_DAYS=30
BACKUP_DISABLED=false
# Nombre d'analyses de documents simultanées (file d'attente)
ANALYSIS_QUEUE_CONCURRENCY=2
