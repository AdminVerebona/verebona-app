NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Stripe : prix de la tarification V2 (CDC) ---
# Genere par : npx tsx src/db/seeds/stripe-prices.ts
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_DUO_MONTHLY=
STRIPE_PRICE_PREMIUM_DUO_YEARLY=

# ── Web Push / VAPID (CDC Notifications §14.5) ──────────────────────────────
# Générer une paire de clés avec : npx web-push generate-vapid-keys
# La clé privée ne doit JAMAIS être exposée au client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@verebona.fr

# Activation générale
VEREBONA_ASSISTANT_ENABLED=true
VEREBONA_ASSISTANT_AI_ENABLED=true
VEREBONA_ASSISTANT_AI_FALLBACK_ENABLED=true

# Alias de modèles (le métier n'utilise JAMAIS un id modèle en dur — §15.11)
VEREBONA_ASSISTANT_DEFAULT_MODEL_ALIAS=assistant-default
VEREBONA_ASSISTANT_ESCALATION_MODEL_ALIAS=assistant-escalation
# Résolution des alias → ids fournisseur (jamais "latest" — §15.13)
VEREBONA_ASSISTANT_MODEL_ASSISTANT_DEFAULT=gemini-2.5-flash-lite
VEREBONA_ASSISTANT_MODEL_ASSISTANT_ESCALATION=gemini-3.1-flash-lite

# Budget IA (§15.5 / §31.2)
VEREBONA_ASSISTANT_MAX_AI_CALLS_PER_REQUEST=2
VEREBONA_ASSISTANT_MAX_INPUT_TOKENS=12000
VEREBONA_ASSISTANT_MAX_OUTPUT_TOKENS=500
VEREBONA_ASSISTANT_MAX_SOURCES=8
VEREBONA_ASSISTANT_MAX_VISIBLE_SOURCES=5
VEREBONA_ASSISTANT_MAX_EXCERPT_CHARS=1500
VEREBONA_ASSISTANT_MAX_CANDIDATES=20

# Timeouts (§30.2)
VEREBONA_ASSISTANT_AI_TIMEOUT_MS=12000
VEREBONA_ASSISTANT_TOTAL_TIMEOUT_MS=20000

# Historique / rate limit / locale (§24 / §6.6 / §21)
VEREBONA_ASSISTANT_HISTORY_DAYS=7
VEREBONA_ASSISTANT_RATE_LIMIT_PER_MINUTE=10
VEREBONA_ASSISTANT_LOCALE=fr-FR

# Cache (§31)
VEREBONA_ASSISTANT_RETRIEVAL_CACHE_TTL_SECONDS=300
VEREBONA_ASSISTANT_HELP_CACHE_TTL_SECONDS=86400
VEREBONA_ASSISTANT_IDEMPOTENCY_TTL_SECONDS=900

# Garde-fous (interdits en V1 — §15.7 / §25.4)
VEREBONA_ASSISTANT_WEB_GROUNDING_ENABLED=false
VEREBONA_ASSISTANT_GEMINI_STORE=false

# Alertes coût (§31.3)
VEREBONA_ASSISTANT_COST_ALERT_USD=0.005

# Clé API Gemini (niveau PAYANT en prod — le gratuit est interdit, §29.5)
# Réutilise la clé existante du projet si déjà présente (doc-ai).
# GEMINI_API_KEY=...

# ══════════════════════════════════════════════════════════════════════════
# REFONTE IA 11 → 5 USAGES — bascule et socle (CDC §10.1)
# ══════════════════════════════════════════════════════════════════════════
# Valeurs admises pour chaque flag :
#   legacy   → ancien moteur seul (valeur par défaut)
#   shadow   → le nouveau moteur décide SANS écrire, les écarts sont mesurés
#   enabled  → nouveau moteur seul, l'ancien est hors du chemin d'exécution
#
# ⚠️ CDC §10.4 — un flag active le nouveau moteur À LA PLACE de l'ancien.
#    Aucune double écriture n'est autorisée, hors mode shadow.

AI_UNIFIED_SOURCE_ANALYSIS=legacy
AI_RECONCILIATION_ENGINE=legacy
AI_INTELLIGENT_ASSISTANT=legacy
AI_AGENDA_ENGINE=legacy
AI_PROMPT_GOVERNANCE=legacy

# Clé fournisseur — utilisée UNIQUEMENT par
# src/services/ai/gateway/providers/gemini.provider.ts (CDC §12, critère 4).
# GEMINI_API_KEY=...