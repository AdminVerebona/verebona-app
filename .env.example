NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000
# URL publique de l'app (sans slash final). Sert aussi aux retours Stripe
# (paiement reussi, « Retour au site », portail client) : en preprod/prod,
# mettre l'URL vue par le navigateur, jamais l'adresse interne du conteneur.
# Ex. preprod : https://app.preprod.verebona.fr
NEXT_PUBLIC_APP_URL=http://localhost:3001
# URL publique lue à l'exécution (prioritaire). À renseigner sur chaque
# environnement hébergé : elle sert aux retours Stripe (paiement, « Retour au site »).
# Une valeur localhost est ignorée quand la requête arrive par un domaine public.
APP_URL=

# --- PostgreSQL : pool de connexions du processus (src/db/pool-config.ts) ---
# DATABASE_URL n'est jamais journalisée ; seules les valeurs ci-dessous le sont
# au démarrage (« [db] pool PostgreSQL — rôle=… max=… »).
# Taille maximale du pool PAR PROCESSUS (entier strictement positif). Un même
# conteneur web porte les API, la file IA, le worker d'exports, la sauvegarde
# et les tâches planifiées. Valeur invalide (0, négative, non numérique) :
# le processus REFUSE de démarrer. Absente : 5 (signalé en production).
# Budget : conteneurs web × 2 (recouvrement au déploiement) × DB_POOL_MAX
# + 2 (postdeploy scripts/migrate.mjs) + scripts ponctuels + administration
# < limite de l'offre PostgreSQL, avec marge (docs/exploitation/migrations-et-sondes.md §3).
# Ne pas monter arbitrairement à 20 ou 50 : mesurer d'abord.
DB_POOL_MAX=
# Durées (secondes, facultatives) : libération d'une connexion inactive
# (défaut 60) et durée de vie maximale d'une connexion (défaut 1800).
DB_POOL_IDLE_TIMEOUT_S=
DB_POOL_MAX_LIFETIME_S=
# Rôle affiché dans le journal de démarrage. Défaut : CONTAINER (Scalingo), sinon « web ».
DB_PROCESS_ROLE=
# Mesures du pool (src/db/pool-metrics.ts) : attente d'acquisition et temps SQL,
# agrégés (minorants : requêtes Drizzle et unsafe seulement), journalisés toutes les N secondes (« [db] pool {…} », seulement s'il y
# a eu de l'activité). Défaut 300 ; 0 = jamais. Aussi dans GET /api/health avec
# x-health-token (checks.dbPool). Aucune requête ni paramètre journalisé.
# DB_POOL_METRICS_LOG_INTERVAL_S=300

# --- Migrations du schéma (APP-PERF-16, lot 24b, src/db/migration-config.ts) ---
# AUCUNE variable obligatoire : les défauts conviennent à Scalingo et au poste local.
# Étape de référence : `postdeploy` du Procfile (node scripts/migrate.mjs),
# avant la mise en service ; un échec CRITIQUE fait échouer le déploiement, un
# index optionnel non construit ne le bloque pas (construit ensuite en arrière-plan).
# Au démarrage web : run (défaut : fichiers critiques seulement, jamais d'index
# CONCURRENTLY ; attend le postdeploy s'il a la main) | check (lecture seule,
# aucune DDL depuis le web, ni maintenance en arrière-plan) | off.
MIGRATIONS_ON_BOOT=
# block (défaut) : migration critique en échec → démarrage refusé.
# degraded : démarrage maintenu (incident), /api/health/ready à 503.
MIGRATIONS_BOOT_POLICY=
# Retirée (lot 24b), ignorée si posée : MIGRATIONS_REPAIR_ON_BOOT.
# Postdeploy seulement : attente du verrou de l'exécutant (ms ; défaut 600000, borné par le budget).
MIGRATION_LOCK_WAIT_MS=
# lock_timeout (défaut 10s) et statement_timeout (défaut 0 = aucun) des migrations ordinaires.
MIGRATION_LOCK_TIMEOUT=
MIGRATION_STATEMENT_TIMEOUT=
# lock_timeout des CREATE / DROP INDEX CONCURRENTLY (postdeploy et maintenance en
# arrière-plan) : ils attendent la fin des transactions de l'ancienne version.
# Défaut 10min (borné par le budget du postdeploy). Durée PG : 500ms, 30s, 10min.
# MIGRATION_INDEX_LOCK_TIMEOUT=
# Budget total du postdeploy (ms ; défaut 900000 = 15 min, plafonné à 19 min :
# Scalingo arrête un postdeploy à 20 min).
# MIGRATION_DEPLOY_BUDGET_MS=
# Démarrage web : attente maximale d'un schéma critique prêt quand le postdeploy
# a la main (ms ; défaut 900000 ; 0 = ne pas attendre, readiness à 503 en attendant).
# MIGRATION_BOOT_WAIT_MS=
# Maintenance des index en arrière-plan (index optionnels en attente ou invalides) :
# intervalle en minutes (défaut 30, doublé à chaque échec jusqu'à 6 h ; 0 = jamais).
# Premier passage 25 min après le démarrage sur Scalingo (après le postdeploy), 15 s ailleurs.
# MIGRATION_INDEX_REBUILD_INTERVAL_MIN=

# --- Identité du déploiement et sondes (APP-PERF-37, src/lib/runtime-identity.ts) ---
# Commit exposé par /api/health* et la télémétrie IA : APP_COMMIT (explicite),
# sinon SOURCE_VERSION (build Scalingo, figée dans l'image), sinon
# CONTAINER_VERSION. Aucune variable Vercel n'est lue.
APP_COMMIT=
APP_VERSION=
# Jeton du diagnostic détaillé de /api/health (en-tête x-health-token ; 16
# caractères minimum). Absent : aucun message SQL / cause S3 exposé.
HEALTH_DIAGNOSTIC_TOKEN=

# --- Secrets de signature (OBLIGATOIRES en production) ---
# Session (jetons JWT). Valeur aléatoire longue, ex. `openssl rand -base64 48`.
JWT_SECRET=
# Liens envoyés par e-mail : vérification d'adresse et réinitialisation du mot
# de passe (jetons HMAC signés, à durée limitée, à usage unique). Facultatifs :
# à défaut, JWT_SECRET est utilisé. Les définir sépare les secrets.
# ⚠️ En production (NODE_ENV=production), le serveur REFUSE DE DÉMARRER si ni
# le secret dédié ni JWT_SECRET n'est défini (src/instrumentation.ts) : la
# valeur de repli est publique, les liens seraient fabricables.
# Changer ce secret invalide les liens en cours (l'utilisateur en redemande un).
EMAIL_VERIFICATION_SECRET=
PASSWORD_RESET_SECRET=

# --- Tâches planifiées (routes /api/cron/*) ---
# Lot 25 : AUCUN planificateur externe n'est nécessaire (ni Scalingo Scheduler,
# ni cron.json, ni crontab) — toutes les tâches tournent dans l'application,
# démarrées par src/instrumentation.ts, coordonnées entre conteneurs par la
# base (une exécution à la fois). VIDER le planificateur externe existant :
# docs/exploitation/taches-planifiees.md (§ 5).
#
# Secret des routes /api/cron/*, conservées pour le déclenchement MANUEL :
#   Authorization: Bearer <CRON_SECRET>
# Sans valeur, ces routes répondent 401 (les tâches internes n'en ont pas
# besoin). Valeur aléatoire longue ; ne jamais la mettre dans une URL.
CRON_SECRET=
#
# Tâches planifiées internes (lot 25, état dans la table scheduled_task_state,
# écran BO Exploitation). Heures de Paris, changements d'heure compris :
#   toutes les minutes   envoi des notifications      (≡ GET /api/cron/notifications/dispatch)
#   toutes les 10 min    notifications « À traiter »  (≡ GET /api/cron/notifications/to-process-scan)
#   /15 min 8h30-11h     rappels du matin             (≡ GET /api/cron/notifications/scheduled-events)
#   05h20                purge des notifications      (≡ GET /api/cron/notifications/purge)
#   toutes les heures    fin des essais               (≡ GET /api/cron/expire-trials)
#   toutes les heures    balayage « À traiter »       (≡ GET /api/cron/to-process/scan)
#   06h10                jalons d'impayé Duo          (≡ GET /api/cron/duo-dunning)
#   toutes les heures    rétractations                (≡ GET /api/cron/withdrawal/process)
#   10h15                avantages de parrainage      (≡ GET /api/cron/referral-rewards)
#   lundi 06h40          intégrité des textes légaux  (≡ GET /api/cron/legal/verify-integrity)
#   au démarrage         transfert de l'ancienne file T3 (≡ GET /api/cron/ai/account-reconciliation)
# Arrêt d'urgence (aucune variable obligatoire) :
#   SCHEDULED_TASKS_DISABLED=true       toutes les tâches ci-dessus
#   SCHEDULED_TASK_<CODE>=off           une tâche (code en majuscules, - → _),
#                                       ex. SCHEDULED_TASK_NOTIFICATIONS_DISPATCH=off
#   SCHEDULED_TASK_ALERT_AFTER_FAILURES alerte de Supervision après N échecs
#                                       consécutifs d'une tâche critique (défaut 3)
#   SCHEDULED_TASKS_MAX_PARALLEL        tâches simultanées par conteneur, hors
#                                       envoi des notifications (1 à 4, défaut 1)
SCHEDULED_TASKS_DISABLED=false
#
# Tâches QUOTIDIENNES internes (une exécution par jour quel que soit le nombre
# d'instances : bail en base, table job_locks). Heures de Paris :
#   01h-05h  sauvegarde de la base            (≡ GET /api/cron/backup)
#   05h-08h  purge des exports RGPD expirés   (≡ GET /api/cron/gdpr-exports-purge)
#   06h-10h  ancienneté des sauvegardes > 48 h → anomalie de Supervision
#   08h-12h  cycle d'impayé de 90 jours       (≡ GET /api/cron/billing-unpaid)
#   08h-12h  suppressions de compte à échéance (≡ GET /api/cron/account-deletion/process)
#   05h-08h  expiration des dossiers V12 > 30 jours (statut « Expiré »,
#            fichiers mis en file de purge) — désactivable par EXPORTS_EXPIRY=off
#   05h-08h  file de purge du stockage S3     (≡ GET /api/cron/purge-blobs)
#            — désactivable par BLOB_PURGE=off
#
# Désactive toutes les tâches quotidiennes internes ci-dessus (hors sauvegarde,
# qui a BACKUP_DISABLED) — ex. si un planificateur externe les appelle déjà.
DAILY_JOBS_DISABLED=false
# Cycle d'impayé : live (rappels J-7/J-1 et suppression à J+90 après
# revérification Stripe) | dry (simulation journalisée, rien n'est écrit —
# recommandé au premier passage en production) | off.
# Valeur inconnue => dry (jamais de suppression sur une faute de frappe).
BILLING_UNPAID_SWEEP=live
# Suppressions de compte planifiées (suppression volontaire à J+30 et rappel
# J-7, rétractation…) :
#   absente/vide : rappels et échéances de moins de 7 jours seulement ; un
#                  ARRIÉRÉ plus ancien, jamais tenté (ex. au premier
#                  déploiement), n'est PAS supprimé : il est signalé une fois
#                  en anomalie (Supervision, « Autres traitements »)
#   live         : explicite — tout, arriéré compris (après examen de l'arriéré)
#   dry          : simulation, rien n'est écrit ni envoyé
#   off          : tâche interne désactivée (planificateur externe)
# Valeur inconnue => dry.
ACCOUNT_DELETION_SWEEP=
# Durée de conservation des archives « Mes données » (heures), purgées ensuite.
GDPR_EXPORT_RETENTION_HOURS=72
# Conservation du journal d'audit du back-office (jours), purge quotidienne
# des lignes échues (src/services/admin/audit-retention.service.ts).
# Absente, vide ou invalide => AUCUNE purge (le journal est conservé).
# Plancher : 30 jours ; une valeur inférieure est ignorée (aucune purge).
ADMIN_AUDIT_RETENTION_DAYS=

# --- Inscription : pré-lancement (src/lib/prelaunch.ts) ---
# full      : inscription ouverte (comportement historique).
# prelaunch : /signup affiche « Verebona ouvre bientôt » et POST /api/users
#             répond 403 SIGNUP_CLOSED, SAUF invitation valide (compte partagé
#             ou Premium Duo). Les comptes créés par admin/seed ne sont pas concernés.
# Absente ou vide => full (aucun environnement fermé par surprise).
# Valeur inconnue => prelaunch (fermé par prudence). « open » = synonyme de full.
# Mêmes valeurs que VITE_DEFAULT_SITE_MODE du site public : basculer les deux
# ensemble au lancement commercial. Lue à l'exécution : redémarrer suffit.
# ⚠️ Variable ABSENTE = full = inscription OUVERTE à tous. En production
# pendant le pré-lancement, elle DOIT être positionnée : SIGNUP_MODE=prelaunch
SIGNUP_MODE=full

# --- Stripe : cles ---
# Toutes les valeurs Stripe d'un environnement doivent venir du MEME mode :
#   local / preprod / recette -> mode Test (sk_test_...)
#   production                -> mode Live (sk_live_...)
# Le client Stripe refuse de demarrer si le mode de la cle ne correspond pas
# a NEXT_PUBLIC_APP_ENV (production|prod|live => live, sinon test).
# Controle complet : npm run stripe:check
STRIPE_SECRET_KEY=
# Secret de l'endpoint webhook cree dans le dashboard, dans le meme mode, sur
#   <NEXT_PUBLIC_APP_URL>/api/billing/stripe-webhook
# Evenements : checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Optionnel : force le mode attendu (test|live) si NEXT_PUBLIC_APP_ENV ne suffit pas
# STRIPE_EXPECTED_MODE=test

# --- Stripe : prix de la tarification V2 (CDC) ---
# Genere par : npx tsx src/db/seeds/seed-stripe-prices.ts (avec la cle du bon mode)
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_DUO_MONTHLY=
STRIPE_PRICE_PREMIUM_DUO_YEARLY=

# ── Web Push / VAPID (CDC Notifications §14.5) ──────────────────────────────
# Générer une paire de clés avec : npx web-push generate-vapid-keys
# La clé privée ne doit JAMAIS être exposée au client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@verebona.fr

# ── Support : notification des échecs d'export (dossiers prêts à l'usage) ──
# Adresse qui reçoit un e-mail interne à chaque génération d'export en échec
# (src/services/exports/export-support-notifier.ts, envoi via Resend :
# RESEND_API_KEY requis). Vide ou absente : aucun envoi, l'échec est seulement
# journalisé et l'export enregistre supportEmailSent=false.
SUPPORT_EMAIL=

# Activation générale
VEREBONA_ASSISTANT_ENABLED=true
VEREBONA_ASSISTANT_AI_ENABLED=true
VEREBONA_ASSISTANT_AI_FALLBACK_ENABLED=true
# Commandes d'écriture depuis le chat (écart acté au CDC §4.8 / §22.5,
# décision produit : conservées). Absente ou vide => ACTIVÉES ; seuls
# off / false / 0 / no les coupent. Pour une V1 strictement conforme au CDC,
# positionner VEREBONA_ASSISTANT_WRITE_COMMANDS=off en production.
VEREBONA_ASSISTANT_WRITE_COMMANDS=on

# Alias de modèles (le métier n'utilise JAMAIS un id modèle en dur — §15.11)
VEREBONA_ASSISTANT_DEFAULT_MODEL_ALIAS=assistant-default
VEREBONA_ASSISTANT_ESCALATION_MODEL_ALIAS=assistant-escalation
# Résolution des alias → ids fournisseur (jamais "latest" — §15.13)
VEREBONA_ASSISTANT_MODEL_ASSISTANT_DEFAULT=gemini-2.5-flash-lite
VEREBONA_ASSISTANT_MODEL_ASSISTANT_ESCALATION=gemini-3.1-flash-lite

# Budget IA (§15.5 / §31.2)
VEREBONA_ASSISTANT_MAX_AI_CALLS_PER_REQUEST=2
VEREBONA_ASSISTANT_MAX_INPUT_TOKENS=12000
# Jetons de sortie : plus de variable (CDC 15 T2-43). La configuration IA
# effective (BO, traitement T2) les fixe, bornée à 500 (§31.2) ; 500 sans
# version. VEREBONA_ASSISTANT_MAX_OUTPUT_TOKENS est IGNORÉE (ni relève ni
# abaisse le plafond) ; encore posée, elle est signalée au démarrage, dans
# /admin/ai-flags et /api/health : à supprimer.
VEREBONA_ASSISTANT_MAX_SOURCES=8
VEREBONA_ASSISTANT_MAX_VISIBLE_SOURCES=5
VEREBONA_ASSISTANT_MAX_EXCERPT_CHARS=1500
VEREBONA_ASSISTANT_MAX_CANDIDATES=20

# Timeouts (§30.2)
VEREBONA_ASSISTANT_AI_TIMEOUT_MS=12000
VEREBONA_ASSISTANT_TOTAL_TIMEOUT_MS=20000

# Historique / rate limit / locale (§24 / §6.6 / §21)
# Conservation de l'historique des conversations, en jours : 90 (décision
# produit « 3 mois », CDC Centre d'aide GAP-16, qui prime sur les 7 jours du
# §24.1). Absente => 90.
VEREBONA_ASSISTANT_HISTORY_DAYS=90
VEREBONA_ASSISTANT_RATE_LIMIT_PER_MINUTE=10
VEREBONA_ASSISTANT_LOCALE=fr-FR

# Cache (§31)
VEREBONA_ASSISTANT_RETRIEVAL_CACHE_TTL_SECONDS=300
VEREBONA_ASSISTANT_HELP_CACHE_TTL_SECONDS=86400
VEREBONA_ASSISTANT_IDEMPOTENCY_TTL_SECONDS=900

# Garde-fous (interdits en V1 — §15.7 / §25.4)
VEREBONA_ASSISTANT_WEB_GROUNDING_ENABLED=false
VEREBONA_ASSISTANT_GEMINI_STORE=false

# Alertes coût (§31.3) — écrites dans ai_alerts ; tout changement de seuil y est tracé
# Coût MOYEN par réponse intelligente sur 24 h (USD)
VEREBONA_ASSISTANT_COST_ALERT_USD=0.005
# Coût IA par utilisateur actif sur 30 jours (USD), global puis par offre (facultatif)
VEREBONA_ASSISTANT_ALERT_COST_PER_ACTIVE_USER_USD=0.30
# VEREBONA_ASSISTANT_ALERT_COST_PER_ACTIVE_USER_USD_PREMIUM=0.30
# VEREBONA_ASSISTANT_ALERT_MIN_ACTIVE_USERS=5

# Débit des routes de lecture de l'assistant (§27), par utilisateur et par minute
# VEREBONA_ASSISTANT_READ_RATE_LIMIT_PER_MINUTE=120

# Clé API Gemini (niveau PAYANT en prod — le gratuit est interdit, §29.5)
# Réutilise la clé existante du projet si déjà présente (doc-ai).
# GEMINI_API_KEY=...

# ══════════════════════════════════════════════════════════════════════════
# REFONTE IA 11 → 5 USAGES — socle (CDC §10.1)
# ══════════════════════════════════════════════════════════════════════════
# Lot 16b (retrait de l'ancien moteur) : PLUS AUCUN drapeau ni commutateur IA.
# Tous les traitements (T1 à T6) tournent sur leur prompt maître, sans repli
# historique ni mode d'observation ; écriture canonique seule ; exports sur la
# source canonique. Variables SUPPRIMÉES (ignorées si encore posées, signalées
# par /api/health et `npm run ai:cutover-check`) :
#   L16b-1  AI_PROMPT_GOVERNANCE, AI_HOME_MASCOT, AI_DURABLE_QUEUE,
#           ANALYSIS_QUEUE_CONCURRENCY (→ AI_QUEUE_CONCURRENCY)
#   L16b-2  AI_INTELLIGENT_ASSISTANT, AI_AGENDA_ENGINE, ASSISTANT_CANONICAL_READ,
#           AI_T4_EFFECTS
#   L16b-3  AI_UNIFIED_SOURCE_ANALYSIS, AI_T1_ANALYSIS_MODE, AI_T1_SHADOW_SAMPLE_RATE,
#           AI_T1_SHADOW_MAX_CONCURRENCY, AI_RECONCILIATION_ENGINE,
#           T3_NEGATIVE_RECONCILIATION, CANONICAL_WRITE_MODE, EXPORTS_CANONICAL_SOURCE

# Clé fournisseur — utilisée UNIQUEMENT par
# src/services/ai/gateway/providers/gemini.provider.ts (CDC §12, critère 4).
# GEMINI_API_KEY=...

# ─── Corpus de recette IA (CDC §11.1) ────────────────────────────────────────
# Compte technique portant les appels modeles de la campagne de mesure.
# Rattacher la campagne a un compte client melangerait ses couts reels avec
# ceux de la mesure, et fausserait le chiffrage que le corpus sert a produire.
#
# Obtenir l'identifiant :  npm run db:seed:corpus-account
# Non requis pour `npm run corpus:dry`, qui n'emet aucun appel.
CORPUS_ACCOUNT_ID=

# ── Stockage objet OVH S3 — CONTRAT UNIQUE (src/lib/s3-config.ts, APP-PERF-26) ──
# Seules ces variables sont lues, et uniquement par src/lib/s3-config.ts
# (garde-fou de non-divergence : s3-config.test.ts). Uploads signés, aperçus,
# proxy, téléchargements, exports, sauvegardes, miniatures et purges utilisent
# la même configuration ; seuls délais et tentatives varient par profil
# (interactive / worker). Diagnostic sans secret : GET /api/health (check s3).
# Obligatoires :
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_BUCKET=
OVH_S3_ACCESS_KEY_ID=
OVH_S3_SECRET_ACCESS_KEY=
# Région : doit correspondre à l'endpoint (s3.<région>.io.cloud.ovh.net). Défaut : gra.
OVH_S3_REGION=gra
# Adressage : true = style chemin (https://endpoint/bucket/clé, défaut, celui
# des uploads signés en production) ; false = virtual-host
# (https://bucket.endpoint/clé). OVH accepte les deux ; le CORS du bucket
# (/api/cron/s3-cors) s'applique aux deux. À valider sur l'OVH utilisé avant
# de changer (GET/PUT signés depuis les origines prod/preprod).
OVH_S3_FORCE_PATH_STYLE=true
# Durée des URL signées de lecture (s, 60 à 604800, défaut 3600).
OVH_S3_SIGNED_URL_TTL_S=3600
# Profil interactif : délai de connexion et d'inactivité (ms, défauts 5000 / 30000) ;
# 2 tentatives au plus. Profil worker : EXPORTS_S3_* ci-dessous ; 3 tentatives.
OVH_S3_CONNECT_TIMEOUT_MS=5000
OVH_S3_REQUEST_TIMEOUT_MS=30000
# ⚠️ OVH_S3_ACCESS_KEY et OVH_S3_SECRET_KEY (anciennes variables de /api/files)
# ne sont PLUS lues : les supprimer. Leur présence est signalée au démarrage.

# ── Miniatures des documents (APP-PERF-06 images, APP-PERF-27 PDF) ──
# Générées côté serveur une fois par version (WebP 480 px, préfixe
# derivatives/thumbnails/ du bucket) ; rendu PDF dans un processus enfant
# borné (scripts/render-pdf-thumbnail.mjs). false = retour arrière : images
# servies par l'ancien proxy, PDF rendus par le navigateur.
THUMBNAILS_ENABLED=true
# Générations simultanées par instance (1 à 4, défaut 1).
THUMBNAILS_CONCURRENCY=1
# Rattrapage horaire borné des documents existants (off pour désactiver).
THUMBNAILS_BACKFILL=on

# ── Sauvegarde quotidienne de la base (stockage OVH_S3_BUCKET, préfixe backups/) ──
# Nuit, entre 1 h et 5 h (Paris). Déclenchement manuel : /admin/backups ou GET /api/cron/backup.
BACKUP_RETENTION_DAYS=30
BACKUP_DISABLED=false
# Analyses de documents : file durable T1 seule (lot 16b) — parallélisme par
# instance réglé par AI_QUEUE_CONCURRENCY (ANALYSIS_QUEUE_CONCURRENCY retirée).

# ── Dossiers prêts à l'emploi V12 : moteur HTML/CSS + Chromium ──
# Documentation : src/services/exports/v12/README.md (architecture, garde-fous,
# migration 0212, déploiement Scalingo — stack scalingo-24 obligatoire).
# Binaire Chromium. Vide : « chromium-headless-shell » installé par Playwright
# (scripts/install-chromium.mjs au postinstall — dans node_modules sur Scalingo,
# ou dans PLAYWRIGHT_BROWSERS_PATH s'il est défini). Renseigner pour utiliser
# un Chromium fourni par l'image (ex. /usr/bin/chromium).
CHROMIUM_EXECUTABLE_PATH=
# Répertoire des navigateurs Playwright (optionnel, lu aussi par Playwright) :
# PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
# Installation du navigateur au postinstall : 1 = toujours, 0 = jamais ;
# vide = seulement sur un build Scalingo (STACK=scalingo-*). Sur Scalingo ou
# avec 1, un échec fait échouer le build (stack scalingo-24 minimum).
EXPORTS_INSTALL_CHROMIUM=
# Worker de génération (une génération à la fois par instance).
# true : aucune génération sur cette instance (instance web seule).
EXPORTS_WORKER_DISABLED=false
# Intervalle de scrutation de la file (ms, défaut 10000).
EXPORTS_WORKER_INTERVAL_MS=10000
# Délai maximal du rendu Chromium d'un dossier, deux passes comprises (ms, défaut 180000).
EXPORTS_RENDER_TIMEOUT_MS=180000
# Délai global d'une génération (ms, défaut 600000) : au-delà, échec RENDER_TIMEOUT
# et le worker passe à la suivante.
EXPORTS_JOB_TIMEOUT_MS=600000
# Demandes de génération (création, relance) par utilisateur et par minute (défaut 6).
EXPORTS_POST_RATE_LIMIT=6
# Délais du client S3 des générations — profil « worker » de src/lib/s3-config.ts,
# aussi utilisé par sauvegardes, purges et miniatures (ms) : connexion (défaut 10000), inactivité (défaut 60000).
EXPORTS_S3_CONNECT_TIMEOUT_MS=10000
EXPORTS_S3_REQUEST_TIMEOUT_MS=60000
# Isolement des PDF sources (worker_thread) : tas maximal (Mo, défaut 512), durée
# maximale d'une opération (ms, défaut 60000), volume décompressé maximal par PDF (Mo, défaut 256).
EXPORTS_ANNEX_WORKER_MEMORY_MB=512
EXPORTS_ANNEX_WORKER_TIMEOUT_MS=60000
EXPORTS_ANNEX_MAX_DECODED_MB=256
# Fermeture de Chromium après inactivité (ms, défaut 60000) ; recyclage après N rendus (défaut 50).
EXPORTS_BROWSER_IDLE_MS=60000
EXPORTS_BROWSER_MAX_RENDERS=50
# Taille maximale d'un fichier source intégré ou joint (octets, défaut 52428800 = 50 Mo).
EXPORTS_MAX_FILE_BYTES=52428800
# Durée de validité des URL signées de téléchargement (s, défaut 60) : le lien
# de l'application revérifie les droits à chaque clic (DRH-010).
EXPORTS_DOWNLOAD_URL_TTL_S=60
# Expiration quotidienne des dossiers de plus de 30 jours (off pour la désactiver).
EXPORTS_EXPIRY=
# Tests d'intégration Chromium : 0 pour les ignorer même si Chromium est présent.
EXPORTS_CHROMIUM_TESTS=

# ══════════════════════════════════════════════════════════════════════════
# Variables lues par le code et jusqu'ici non documentées (inventaire lot 24)
# Toutes FACULTATIVES et COMMENTÉES : décommenter pour fixer une valeur ;
# absentes = valeur par défaut indiquée. Ne pas les laisser posées vides.
# ══════════════════════════════════════════════════════════════════════════

# ── Dépôt de documents (client et confirmation) ──
# Transferts simultanés d'un dépôt multiple (1 à 3, défaut 2). FIGÉE AU BUILD
# (NEXT_PUBLIC_*) : la changer impose un nouveau build. 1 = repli séquentiel
# (comportement antérieur), à utiliser si des envois parallèles posent problème.
# NEXT_PUBLIC_UPLOAD_CONCURRENCY=
# Vérification de la présence de l'objet S3 (HEAD) avant de confirmer un dépôt
# (défaut true). false = interrupteur d'exploitation (stockage lent ou HEAD
# refusé) : la confirmation fait alors confiance au client.
# UPLOAD_CONFIRM_VERIFY_OBJECT=
# Demandes d'URL de dépôt (presign) par utilisateur et par minute (défaut 10).
# FILE_PRESIGN_RATE_LIMIT=
# Ancien repli client des miniatures (src/components/thumbnail-upload.tsx) ;
# le contrat S3 serveur est OVH_S3_* (voir plus haut).
# NEXT_PUBLIC_OVH_S3_BUCKET=
# NEXT_PUBLIC_OVH_S3_ENDPOINT=

# ── Abonnement / Stripe ──
# Réconciliation quotidienne des paiements engagés non constatés (APP-PERF-18) :
# active par défaut ; off/false/0 la retire de la maintenance quotidienne.
# PENDING_CHECKOUT_RECONCILE=
# Codes promotionnels saisis dans Stripe Checkout (true pour les autoriser).
# STRIPE_CHECKOUT_ALLOW_PROMOTION_CODES=
# Configuration du portail Stripe pour les montées en gamme (sinon créée/lue par le code).
# STRIPE_PORTAL_UPGRADE_CONFIGURATION_ID=
# Anciens Price IDs génériques (src/lib/stripe.ts) ; les parcours actuels lisent
# STRIPE_PRICE_<OFFRE>_MONTHLY / _YEARLY (voir src/lib/stripe-prices.ts).
# STRIPE_PRICE_STANDARD=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_PREMIUM_DUO=

# ── E-mails et contact ──
# Adresse de contact affichée dans les e-mails légaux (défaut contact@verebona.fr).
# CONTACT_EMAIL=
# Expéditeur des e-mails de parrainage (défaut no-reply@verebona.fr).
# RESEND_FROM_EMAIL=
# Expéditeur générique (contrôlé par le diagnostic /api/cron/db-inspect).
# EMAIL_FROM=
# RESEND_FROM=

# ── RGPD ──
# Budget (ms) d'une génération immédiate de l'export RGPD avant bascule en
# traitement différé (défaut 8000).
# GDPR_EXPORT_IMMEDIATE_MS=

# ── File IA, rétention et archivage ──
# AI_QUEUE_INTERVAL_MS : scrutation de la file (défaut 15000)
# AI_QUEUE_INTERVAL_MS=
# AI_QUEUE_LEASE_SECONDS : bail d'un travail (défaut 300)
# AI_QUEUE_LEASE_SECONDS=
# AI_QUEUE_LEGACY_STALE_SECONDS : travaux hérités considérés bloqués (défaut 3600)
# AI_QUEUE_LEGACY_STALE_SECONDS=
# AI_QUEUE_MAX_DEFERRALS : reports avant échec définitif (défaut 3)
# AI_QUEUE_MAX_DEFERRALS=
# T3_EVENT_DEBOUNCE_MS : temporisation d'un contrôle compte après événement (défaut 600000)
# T3_EVENT_DEBOUNCE_MS=
# AI_LOG_ARCHIVE_AFTER_DAYS : archivage des journaux IA au-delà de N jours (défaut 88)
# AI_LOG_ARCHIVE_AFTER_DAYS=
# AI_TRACE_DETAILED_RETENTION_DAYS : traces détaillées de l'assistant (défaut 30)
# AI_TRACE_DETAILED_RETENTION_DAYS=
# AI_TRACE_TECHNICAL_RETENTION_DAYS : journaux techniques (défaut 90)
# AI_TRACE_TECHNICAL_RETENTION_DAYS=
# AI_AGGREGATE_RETENTION_MONTHS : agrégats (défaut 13)
# AI_AGGREGATE_RETENTION_MONTHS=
# AI_FEEDBACK_RETENTION_MONTHS : avis utilisateurs (défaut 13)
# AI_FEEDBACK_RETENTION_MONTHS=
# Administrateurs (identifiants, séparés par des virgules) autorisés à lire le
# contenu conversationnel T2 dans le BO. Vide = personne.
# AI_T2_CONTENT_ADMIN_IDS=
# Tests seulement : true court-circuite l'idempotence IA (jamais en production).
# AI_IDEMPOTENCY_DISABLED=
# Phase du contrôle des appels IA hérités (scripts/check-legacy-ai.mjs, défaut 1).
# AI_MIGRATION_PHASE=
# Fournisseur Gemini : clé alternative à GEMINI_API_KEY ; tarifs Google Cloud Billing.
# GOOGLE_AI_API_KEY=
# GOOGLE_BILLING_API_KEY=
# GOOGLE_BILLING_SERVICE_ID=

# ── Assistant Verebona (réglables aussi dans le BO, qui l'emporte) ──
# Commutateurs (on/off) : aide produit, IA sur les données du compte, modèle de
# repli, sources (défaut on) ; recherche sémantique (défaut off) ; purge
# quotidienne des journaux de l'assistant (off = confiée à un planificateur externe).
# VEREBONA_ASSISTANT_PRODUCT_HELP=
# VEREBONA_ASSISTANT_ACCOUNT_AI=
# VEREBONA_ASSISTANT_FALLBACK_MODEL=
# VEREBONA_ASSISTANT_SOURCES=
# VEREBONA_ASSISTANT_SEMANTIC_RETRIEVAL=
# VEREBONA_ASSISTANT_PURGE=
# Débits : écritures/minute/utilisateur (défaut 30) ; multiplicateurs par compte (3) et par IP (5).
# VEREBONA_ASSISTANT_MUTATION_RATE_LIMIT_PER_MINUTE=
# VEREBONA_ASSISTANT_ACCOUNT_RATE_MULTIPLIER=
# VEREBONA_ASSISTANT_IP_RATE_MULTIPLIER=
# Budget mensuel par compte (micro-USD, défaut 2000000 ; 0 = sans plafond) et seuil d'alerte (0.8).
# VEREBONA_ASSISTANT_MONTHLY_BUDGET_MICROS=
# VEREBONA_ASSISTANT_BUDGET_ALERT_RATIO=
# VEREBONA_ASSISTANT_RETRIEVAL_TIMEOUT_MS : défaut 3000
# VEREBONA_ASSISTANT_RETRIEVAL_TIMEOUT_MS=
# VEREBONA_ASSISTANT_TIMELINE_MAX_EVENTS : 1 à 200, défaut 60
# VEREBONA_ASSISTANT_TIMELINE_MAX_EVENTS=
# Modèles : preview autorisés en production (double validation BO), même modèle
# en principal et en repli (true pour l'autoriser), diagnostic preview ponctuel (on),
# dépréciations déclarées (modèle=AAAA-MM-JJ, séparés par des virgules).
# VEREBONA_ASSISTANT_PREVIEW_MODELS_ALLOWED=
# VEREBONA_ASSISTANT_ALLOW_PREVIEW_MODELS=
# VEREBONA_ASSISTANT_ALLOW_SAME_MODEL=
# VEREBONA_ASSISTANT_DIAGNOSTIC_PREVIEW=
# VEREBONA_ASSISTANT_MODEL_DEPRECATIONS=
# Alertes d'exploitation : taux d'escalade (0.10), dérive de jetons (0.30), écart
# de modèle (0.01), préavis de dépréciation (30 j), échantillon minimal (20),
# coût par utilisateur actif (0.30 USD ; par offre : _USD_<PLAN>).
# VEREBONA_ASSISTANT_ALERT_ESCALATION_RATE=
# VEREBONA_ASSISTANT_ALERT_TOKEN_DRIFT=
# VEREBONA_ASSISTANT_ALERT_MODEL_MISMATCH_RATE=
# VEREBONA_ASSISTANT_ALERT_DEPRECATION_DAYS=
# VEREBONA_ASSISTANT_ALERT_MIN_SAMPLE=
# VEREBONA_ASSISTANT_ALERT_COST_PER_ACTIVE_USER_USD=
# Secret des jetons de recherche de l'assistant (défaut : JWT_SECRET).
# VEREBONA_SEARCH_TOKEN_SECRET=
# Proxys de confiance devant l'application pour lire X-Forwarded-For (défaut 1 :
# routeur Scalingo ; 0 = en-tête ignoré).
# TRUSTED_PROXY_HOPS=

# ── Exploitation, recette et outils ──
# Interrupteurs de routes d'exploitation, refusées en production sans eux :
# ALLOW_ADMIN_GRANT=
# ALLOW_TRIAL_RESET=
# Neutralisation d'un instantané de production (recette) : true pour l'autoriser
# sur CET environnement ; comptes de test conservés (identifiants, virgules).
# ALLOW_SNAPSHOT_NEUTRALIZATION=
# PREPROD_TEST_ACCOUNTS=
# Commit figé au build (next.config.mjs, depuis SOURCE_VERSION) — ne pas poser à la main.
# APP_BUILD_COMMIT=
# Exports V12 : emplacements du worker d'annexes et des ressources statiques (image Docker).
# EXPORTS_V12_ANNEX_WORKER=
# EXPORTS_V12_STATIC_DIR=
# Centre d'aide lu par l'assistant (défaut : NEXT_PUBLIC_PUBLIC_SITE_URL) ;
# catalogue contrôlé par src/scripts/check-help-shortcuts.ts.
# HELP_CENTER_URL=
# HELP_CATALOG_URL=
# Postbuild : PRUNE_IMAGE=1 élague aussi le cache de build en local.
# PRUNE_IMAGE=
# Recette des migrations seulement (scripts/migrate.mjs) : dossier des fichiers
# et schéma (search_path) de la connexion.
# MIGRATIONS_DIR=
# MIGRATIONS_SCHEMA=
